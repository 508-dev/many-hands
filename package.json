{
  "name": "many-hands",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "bun run --cwd apps/web build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --cwd apps/web typecheck",
    "test": "bun run smoke",
    "smoke": "./apps/pocketbase/scripts/smoke.sh",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  }
}
